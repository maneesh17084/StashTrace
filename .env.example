# Copy to .env (never commit .env). Environment variables override this file.
# SQLite database file (the API and worker must point at the same file on a local disk, not a network share).
STASHTRACE_DB_URL=sqlite:///var/stashtrace.db
# Password the loader sets for the dataset's demo_logins. Choose your own; leave blank to set none.
STASHTRACE_DEMO_PASSWORD=
STASHTRACE_TOKEN_TTL_HOURS=12
STASHTRACE_WORKER_POLL_SECONDS=2
STASHTRACE_IMPORT_CHUNK=5000
STASHTRACE_MAX_UPLOAD_MB=512
# true = the API process drains the job queue itself (single-process demo); keep false when the worker runs.
STASHTRACE_RUN_JOBS_INLINE=false
# SQLite page cache and memory-map sizes per connection (large imports need the hot indexes in memory).
STASHTRACE_SQLITE_CACHE_MB=256
STASHTRACE_SQLITE_MMAP_MB=1024
STASHTRACE_LOG_LEVEL=INFO
